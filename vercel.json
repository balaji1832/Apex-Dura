{
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/aboutus$", "dest": "/aboutus.html" },
    { "src": "^/products$", "dest": "/products.html" },
    { "src": "^/contact-us$", "dest": "/contact-us.html" },
    { "src": "^/infrastructure$", "dest": "/infrastructure.html" },
    { "src": "^/investor-corner$", "dest": "/investor-corner.html" },
    { "src": "^/demo$", "dest": "/demo.html" },
    { "src": "^/estimator$", "dest": "/estimator.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
